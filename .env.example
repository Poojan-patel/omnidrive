# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — do NOT commit it.
#
# Get GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET by creating an OAuth 2.0
# Web application client in your GCP project (see README for setup steps).

GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

# Where Google should redirect after consent. Must match EXACTLY one of the
# Authorized redirect URIs in your OAuth client config.
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Where the local server listens
BIND_ADDR=127.0.0.1:8765

# Logging — show our app's logs at info, request logging at info, hide chatter
RUST_LOG=omnidrive=info,tower_http=info
